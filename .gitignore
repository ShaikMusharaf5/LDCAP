# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IDE and editor files
.vscode/
.idea/
*.suo
*.user
*.userossc
*.sln.docstates

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Environment and local secrets
.env
.env.*
.python-version
.streamlit/secrets.toml

# Streamlit runtime cache
.streamlit/cache/

# Logs
*.log

# Large local training artifacts
# Keep the checkpoints folder structure, but ignore downloadable/generated runtime assets by default.
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.ckpt
vocab.json
!checkpoints/.gitkeep
